def properties = new Properties()
new File('../gradle.properties').withInputStream { properties.load(it) }
def pluginJar = System.getenv('NFT_PARQUET_JAR') ?: "../build/libs/nft-parquet-${properties.getProperty('version')}.jar"

config {
    requires 'nf-test': '0.9.5'
    testsDir "tests"
    workDir ".nf-test"
    configFile "tests/nextflow.config"
    // Reuse Fixtures.Projection from Java source; do not commit compiled records.
    // https://www.nf-test.com/docs/configuration/#nf-testconfig (libDir)
    libDir "../build/classes/java/test"
    profile ""
    plugins {
        loadFromFile new File(pluginJar).canonicalPath
    }
}
